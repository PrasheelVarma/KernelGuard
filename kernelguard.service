[Unit]
Description=KernelGuard eBPF Security Monitor
After=network.target

[Service]
Type=forking
PIDFile=/tmp/kernelguard.pid
ExecStart=/opt/kernelguard/venv/bin/python3 -m kernelguard.cli --daemon --enforce --policy /home/prasheel/SATA_VAULT/developer/KernelGuard/policy.json
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=10
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
